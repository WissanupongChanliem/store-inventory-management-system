{
  "name": "store-management-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the store management system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && jest --runInBand",
    "test:auth": "npm run build && jest --runInBand --runTestsByPath dist/test/auth.test.js",
    "test:products": "npm run build && jest --runInBand --runTestsByPath dist/test/products.test.js",
    "test:checkout": "npm run build && jest --runInBand --runTestsByPath dist/test/checkout.test.js",
    "test:sales": "npm run build && jest --runInBand --runTestsByPath dist/test/sales.test.js",
    "test:health": "npm run build && jest --runInBand --runTestsByPath dist/test/health.test.js",
    "test:schema": "npm run build && jest --runInBand --runTestsByPath dist/test/schema.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
